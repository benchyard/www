{
  "name": "benchyard-www",
  "private": true,
  "type": "module",
  "description": "Benchyard's homepage: a static site",
  "scripts": {
    "build": "node build.mjs",
    "check": "node build.mjs && node check.mjs",
    "dev": "node build.mjs && node serve.mjs",
    "test": "playwright test",
    "format:check": "prettier --check content/*.mjs src/*.mjs src/*.css build.mjs check.mjs serve.mjs studio/*.mjs studio/fixture/*.mjs studio/fixture/board.html tests/*.mjs playwright.config.mjs",
    "measure": "node studio/measure.mjs",
    "demo:capture": "sg docker -c \"bash studio/record.sh\"",
    "card": "node studio/render-poster.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "lightningcss": "^1.33.0",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5"
  }
}
